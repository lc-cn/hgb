#!/usr/bin/python3
"""Root-owned activation entry point; application archives are extracted without root."""
import fcntl
from contextlib import closing
import http.client
import json
import os
from pathlib import Path
import pwd
import re
import shutil
import sqlite3
import subprocess
import sys
import time

BASE = Path('/opt/hgb')
DATA = Path('/var/lib/hgb')
BACKUPS = Path('/var/backups/hgb')
SERVICE = 'hgb.service'
DEPLOYMENT = re.compile(r'[a-f0-9]{40}-[0-9]+-[0-9]+')


def systemctl(*args):
    return subprocess.run(['/usr/bin/systemctl', *args, SERVICE], check=True,
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE)


def healthy():
    connection = http.client.HTTPConnection('127.0.0.1', 8787, timeout=2)
    try:
        connection.request('GET', '/api/me')
        response = connection.getresponse()
        body = response.read()
        return response.status == 401 and json.loads(body).get('code') == 'invalid_session'
    except (OSError, ValueError, http.client.HTTPException):
        return False
    finally:
        connection.close()


def wait_healthy():
    deadline = time.monotonic() + 60
    while time.monotonic() < deadline:
        if healthy():
            return
        time.sleep(1)
    raise RuntimeError('HGB readiness failed; inspect hgb.service journal on the host')


def point_to(release):
    link = BASE / 'server'
    if release is None:
        link.unlink(missing_ok=True)
        return
    temporary = BASE / f'.server-{os.getpid()}'
    temporary.symlink_to(release)
    os.replace(temporary, link)


KEEP_DAYS = 14


def prune_backups(current=None):
    """Deletes database snapshots older than KEEP_DAYS, as the privacy policy promises. Runs after each deploy and daily
    (hgb-prune-backups.timer), so a quiet month without deploys keeps nothing older either."""
    cutoff = time.time() - KEEP_DAYS * 86400
    for path in BACKUPS.iterdir():
        if path.is_dir() and not path.is_symlink() and DEPLOYMENT.fullmatch(path.name) and path.name != current and path.stat().st_mtime < cutoff:
            shutil.rmtree(path)


def activate(deployment):
    if not DEPLOYMENT.fullmatch(deployment):
        raise ValueError('Invalid deployment identifier')
    release = BASE / 'releases' / deployment
    if release.is_symlink() or not release.is_dir():
        raise ValueError('Release must be a real directory')
    release = release.resolve(strict=True)
    if release.stat().st_uid != pwd.getpwnam('hgb-deploy').pw_uid:
        raise ValueError('Release has unexpected owner')
    executable = release / 'bin/server'
    if executable.is_symlink() or not executable.is_file() or not os.access(executable, os.X_OK):
        raise ValueError('Release has no executable bin/server')
    link = BASE / 'server'
    if link.exists() and not link.is_symlink():
        raise ValueError('Current deployment is not a symlink')
    previous = link.resolve(strict=True) if link.is_symlink() else None
    if previous is not None and previous.parent != (BASE / 'releases').resolve(strict=True):
        raise ValueError('Previous deployment is outside releases')
    if previous == release and healthy():
        return {'deployment': deployment, 'already_active': True}
    if previous == release:
        raise RuntimeError('Existing deployment is unhealthy; inspect before retrying')
    backup = BACKUPS / deployment
    if backup.exists():
        raise RuntimeError('Prior activation evidence exists; inspect before retrying')
    backup.mkdir(mode=0o700)
    was_active = subprocess.run(['/usr/bin/systemctl', 'is-active', '--quiet', SERVICE]).returncode == 0
    database = DATA / 'hgb.db'
    existed = database.exists()
    metadata = {'deployment': deployment, 'previous': str(previous) if previous else None,
                'previous_active': was_active, 'database_existed': existed}
    (backup / 'activation.json').write_text(json.dumps(metadata, indent=2) + '\n')
    systemctl('stop')
    # Snapshot after stopping the only writer. The snapshot is independent of journals/WAL.
    try:
        if existed:
            with closing(sqlite3.connect(database)) as source, closing(sqlite3.connect(backup / 'hgb.db')) as target:
                source.backup(target)
            (backup / 'hgb.db').chmod(0o600)
    except Exception:
        if was_active:
            systemctl('start')
        raise
    try:
        point_to(release)
        subprocess.run(['/usr/bin/systemd-analyze', 'verify', '/etc/systemd/system/hgb.service'],
                       check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        systemctl('start')
        wait_healthy()
        if previous is None:
            systemctl('enable')
    except Exception:
        # Do not erase a failed migration: preserve its database alongside the pre-deploy snapshot.
        systemctl('stop')
        failed = backup / 'failed-state'
        failed.mkdir(mode=0o700)
        for suffix in ('', '-wal', '-shm', '-journal'):
            path = Path(str(database) + suffix)
            if path.exists():
                shutil.move(path, failed / path.name)
        if existed:
            shutil.copy2(backup / 'hgb.db', database)
            owner = pwd.getpwnam('hgb')
            os.chown(database, owner.pw_uid, owner.pw_gid)
            database.chmod(0o600)
        point_to(previous)
        if was_active:
            systemctl('start')
            wait_healthy()
        metadata['outcome'] = 'rolled_back'
        (backup / 'activation.json').write_text(json.dumps(metadata, indent=2) + '\n')
        raise
    metadata['outcome'] = 'healthy'
    (backup / 'activation.json').write_text(json.dumps(metadata, indent=2) + '\n')
    prune_backups(deployment)
    return {'deployment': deployment, 'healthy': True, 'backup': str(backup)}


if __name__ == '__main__':
    if os.geteuid() != 0 or len(sys.argv) != 2:
        raise SystemExit('Run the root-owned activator with one deployment identifier, or --prune')
    os.umask(0o077)
    with open('/run/lock/hgb-deploy.lock', 'a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if sys.argv[1] == '--prune':
            prune_backups()
        else:
            print(json.dumps(activate(sys.argv[1])), flush=True)
