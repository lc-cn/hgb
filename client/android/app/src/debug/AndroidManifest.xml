<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config">
        <service android:name=".vision.ApplicationStartupProbeService"
            android:exported="false" android:process=":maa_ocr" />
        <!-- Debug only: shell (adb) holds DUMP; ordinary apps cannot send this. -->
        <receiver android:name=".debug.LocalTaskTrigger" android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter><action android:name="io.github.yysassist.debug.RUN_LOCAL_TASK" /></intent-filter>
        </receiver>
        <receiver android:name=".debug.DemoTaskSeeder" android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter><action android:name="io.github.yysassist.debug.SEED_DEMO_TASKS" /></intent-filter>
        </receiver>
    </application>
</manifest>
