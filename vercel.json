{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "site": {
      "root": "client/site",
      "framework": "astro",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "pnpm build",
      "outputDirectory": "dist",
      "headers": [
        {
          "source": "/_astro/(.*)",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        }
      ]
    },
    "console": {
      "root": "client/web",
      "framework": "vite",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "pnpm build && find dist -name '*.map' -delete",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/console/:path((?!assets/).*)", "destination": "/console/index.html" }
      ],
      "headers": [
        {
          "source": "/console/assets/(.*)",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        }
      ]
    }
  },
  "redirects": [
    { "source": "/console", "destination": "/console/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/console/(.*)", "destination": { "service": "console" } },
    { "source": "/(.*)", "destination": { "service": "site" } }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
